int success, total;

void md5_calc_seq() {
    /* 1. Use uint32_t pointers to ensure +1 moves 4 bytes */
    volatile uint32_t *ctrl = (uint32_t *)md5_group_control;
    volatile uint32_t *data = (uint32_t *)md5_group_data;

    int i;
    struct timespec start_time, stop_time;
    uint32_t hashed[4] = {0};

    /* MD5 Padding for 'hello' (56 bytes of data/padding + 8 bytes of length) */
    uint32_t md5_input[16] = {
        0x00000000, 0x00000000, 0x00000080, 0x00000000,
        0x00000000, 0x00000000, 0x00000000, 0x00000000,
        0x00000000, 0x00000000, 0x00000000, 0x00000000,
        0x00000000, 0x00000020,
        0x00000080, // Length in bits (5 chars * 8 = 40 bits = 0x28)
        0x61616161
    };

    /* 2. RESET SEQUENCE: Pull high, then RELEASE */
    alt_write_word(ctrl + 1, 0xFFFFFFFF);
    alt_write_word(ctrl + 1, 0x00000000); // Engine is now ready to listen

    /* 3. WRITE DATA to FPGA RAM */
    for (i = 0; i < 16; i++) {
        alt_write_word(ctrl + 2, 0x0);       // Disable Write Enable (WR)
        alt_write_word(data, md5_input[i]);  // Set Data
        alt_write_word(data + 1, (uint32_t)i); // Set Address
        alt_write_word(ctrl + 2, 0x1);       // Pulse Write Enable (WR)
    }
    alt_write_word(ctrl + 2, 0x0); // Ensure WR is low after loading

    /* 4. START THE ENGINE with a rising edge */
    clock_gettime(CLOCK_MONOTONIC, &start_time);

    alt_write_word(ctrl, 0x1); // Start High
    alt_write_word(ctrl, 0x0); // Start Low (This creates the 'Edge' to begin)

    /* 5. POLL FOR DONE (Bit 0 of offset +2) */
    printf("Waiting for hardware...\n");
    while (!(alt_read_word(ctrl + 2) & 0x1)) {
        // Busy wait - if it hangs here, the FPGA never finished
    }

    clock_gettime(CLOCK_MONOTONIC, &stop_time);

    /* 6. READ DIGEST (A, B, C, D) */
    for (i = 0; i < 4; i++) {
        alt_write_word(data + 3, (uint32_t)i); // Set read address for digest
        hashed[i] = alt_read_word(data + 3);   // Read 32-bit word
    }

    /* Calculate elapsed time in nanoseconds */
    uint64_t diff = (stop_time.tv_sec - start_time.tv_sec) * 1000000000ULL +
                    (stop_time.tv_nsec - start_time.tv_nsec);

    printf("Digest: %08x%08x%08x%08x\nTime: %llu ns\n",
            hashed[0], hashed[1], hashed[2], hashed[3], diff);
}




void md5_calc_par(){
	alt_write_word(md5_group_control +1, 0xFFFFFFFF); // reset


	struct timespec start_time, stop_time;
	double elapsed_time;
	char *word = "hello";
	char *word2 = "COE838";
